---
import { getCollection } from 'astro:content';
import Layout from './Layout.astro';
import { Sidebar } from '../components/dashboard/Sidebar';
import type { NavKey } from '../components/dashboard/Sidebar';
import { CommandPalette } from '../components/dashboard/CommandPalette';

interface Props {
  title: string;
  /** Omitted for pages that are not in the sidebar, e.g. 404. */
  current?: NavKey;
}

const { title, current } = Astro.props;

// Read at build time so the palette lists whatever is in the collection
// rather than a second, hand-maintained copy of it.
const docs = (await getCollection('docs'))
  .sort((a, b) => a.data.order - b.data.order)
  .map((doc) => ({ slug: doc.id, title: doc.data.title }));
---

<Layout title={title}>
  <div class="app-shell">
    <Sidebar current={current} client:load />
    <main class="app-main">
      <slot />
    </main>
  </div>
  <CommandPalette docs={docs} client:load />
</Layout>
