---
import { ClientRouter } from 'astro:transitions';
import '@backstage/ui/css/styles.css';
import '../styles/dashboard.css';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link
      rel="icon"
      type="image/svg+xml"
      href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/favicon.svg`}
    />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    {/*
      Client-side routing: Astro fetches the next page and swaps the document
      instead of reloading it, so persisted islands keep their state and there
      is no flash between pages.
    */}
    <ClientRouter />
    {/*
      Applies the stored theme before first paint so navigating between pages
      never flashes the light theme. Must stay inline and un-deferred.
    */}
    <script is:inline>
      (function () {
        function applyTheme() {
          var mode = 'light';
          try {
            if (localStorage.getItem('acme-theme-mode') === 'dark') mode = 'dark';
          } catch (e) {
            /* storage unavailable — fall back to light */
          }
          document.documentElement.setAttribute('data-theme-mode', mode);
        }
        applyTheme();
        // A swap replaces <html>, taking the attribute with it, so the theme
        // has to be re-applied before the new document is painted.
        document.addEventListener('astro:after-swap', applyTheme);
      })();
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  html,
  body {
    margin: 0;
    padding: 0;
    background: var(--bui-bg-app);
    color: var(--bui-fg-primary);
    font-family: var(--bui-font-regular, sans-serif);
  }
</style>
